APP_NAME="Executive Desk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Default display time zone for new users (IANA identifier).
APP_DEFAULT_USER_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=executive_desk
DB_USERNAME=executive_desk
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=150

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development: "log" writes emails to storage/logs/laravel.log.
# Production: set MAIL_MAILER=smtp and fill in your provider's SMTP settings.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="executive-desk@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS: "none" reports SMS as unavailable; "log" writes messages to the log (development only).
SMS_DRIVER=none
SMS_FROM=

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Restrict to a Google Workspace domain (optional), e.g. yourcompany.com
GOOGLE_HOSTED_DOMAIN=

# Audit trail: record page views too; delete entries older than N days (0 = keep forever)
AUDIT_PAGE_VIEWS=true
AUDIT_RETENTION_DAYS=0

# Shown on the sign-in page as the administrator contact (optional)
APP_SUPPORT_EMAIL=

# Web Push (VAPID). Generate keys with: php artisan push:vapid
VAPID_SUBJECT="mailto:executive-desk@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
